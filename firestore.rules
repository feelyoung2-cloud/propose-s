rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 과천시 불편함 설문 응답 컬렉션 (responses)
    match /responses/{responseId} {
      // 읽기 허용: 학생 및 교사용 통계 화면
      allow read: if true;
      
      // 생성 검증: 타임스탬프, 장소(최대 100자), 문제유형(최대 100자), 상황(최대 150자)
      allow create: if request.resource.data.ts != null
                   && request.resource.data.issue is string
                   && request.resource.data.issue.size() <= 100
                   && request.resource.data.location is string
                   && request.resource.data.location.size() <= 100
                   && request.resource.data.situation is string
                   && request.resource.data.situation.size() <= 150;
      
      // 삭제 허용: 교사용 화면에서 수업 전후 응답 초기화
      allow delete: if true;
      
      // 수정 금지
      allow update: if false;
    }

    // 2. 과천시를 위한 제안하는 글 컬렉션 (proposals)
    match /proposals/{proposalId} {
      // 읽기 허용: 학생 및 교사용 공감 게시판
      allow read: if true;
      
      // 생성 검증: 모둠(1~6), 이름, 수신인, 문제상황, 제안, 까닭, 초기 공감수 0, 제출 완료 플래그
      allow create: if request.resource.data.ts != null
                   && request.resource.data.team is int
                   && request.resource.data.team >= 1 && request.resource.data.team <= 6
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
                   && request.resource.data.recipient is string
                   && request.resource.data.recipient.size() <= 50
                   && request.resource.data.problem is string
                   && request.resource.data.problem.size() > 0 && request.resource.data.problem.size() <= 300
                   && request.resource.data.proposal is string
                   && request.resource.data.proposal.size() > 0 && request.resource.data.proposal.size() <= 300
                   && request.resource.data.reason1 is string
                   && request.resource.data.reason1.size() > 0 && request.resource.data.reason1.size() <= 300
                   && (request.resource.data.reason2 == null || (request.resource.data.reason2 is string && request.resource.data.reason2.size() <= 300))
                   && request.resource.data.likes is int
                   && request.resource.data.likes == 0
                   && request.resource.data.submitted == true;
      
      // 수정 허용: 오직 likes 필드만 정확히 1 증가하는 트랜잭션 업데이트만 허용
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                   && request.resource.data.likes == resource.data.likes + 1;
      
      // 삭제 허용: 수업 데이터 관리
      allow delete: if true;

      // 3. 제안 댓글 서브컬렉션 (proposals/{proposalId}/comments)
      match /comments/{commentId} {
        allow read: if true;
        
        allow create: if request.resource.data.ts != null
                     && request.resource.data.type in ['good', 'improve']
                     && request.resource.data.team is int
                     && request.resource.data.team >= 1 && request.resource.data.team <= 6
                     && request.resource.data.content is string
                     && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 200;
        
        allow update, delete: if false;
      }
    }
  }
}
